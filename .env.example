# ============ RuleForge 配置示例 ============
# 复制本文件为 .env 并填入真实值，然后启动项目

# Claude API 密钥（必填，未配置时解析功能不可用）
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# 自定义 API 端点（可选）：网络无法直连官方时，指向兼容 Anthropic 协议的中转端点
# ANTHROPIC_BASE_URL=https://your-relay.example.com

# 模型（默认当前最新 Opus；如无特殊需求不要改动）
ANTHROPIC_MODEL=claude-opus-5-5

# LLM 调用参数
LLM_MAX_TOKENS=8192
LLM_EFFORT=medium
LLM_TIMEOUT=60
LLM_SDK_MAX_RETRIES=1

# 自然语言解析时，JSON 格式错误最多重试次数（阶段0要求为 2）
JSON_MAX_RETRIES=2

# 本地存储与日志
DB_PATH=storage/ruleforge.db
LOG_DIR=logs
LOG_LEVEL=INFO
